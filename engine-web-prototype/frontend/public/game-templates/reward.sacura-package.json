    "logicResources": [
      {
        "id": "sample-source-Reward",
        "version": 1,
        "kind": "component.code",
        "name": "Reward",
        "path": "Компоненты/Reward.js",
        "definitionId": "sample.component.reward",
        "status": "ready",
        "approved": true,
        "source": "// Упражнение: замените base * multiplier на base * multiplier + 5.\n// Получатель — явная ссылка на Counter, одинаковая логика для очков, монет и отношения.\n// Добавьте новый метод bonus с вызовом engine.invoke(refs.counter, \"add\", {amount: ...}).\nconst component = {\n  name: \"Reward\",\n  parameters: {\n    type: \"object\",\n    properties: {\n      base: { type: \"number\", default: 1, label: \"Базовая награда\" },\n      multiplier: { type: \"number\", default: 1, label: \"Множитель награды\" },\n    },\n  },\n  references: {\n    type: \"object\",\n    properties: {\n      counter: { type: \"reference\", referenceType: \"mechanic\", label: \"Куда начислять · Counter\" },\n    },\n  },\n  state: {\n    type: \"object\",\n    properties: { awards: { type: \"integer\", default: 0, label: \"Выдано наград\" } },\n  },\n  signals: {\n    awarded: {\n      name: \"Награда выдана\",\n      payloadSchema: {\n        type: \"object\",\n        properties: { amount: { type: \"number\" }, value: { type: \"number\" } },\n      },\n    },\n  },\n  methods: {\n    award: {\n      name: \"Начислить награду\",\n      parameters: {\n        type: \"object\",\n        properties: { factor: { type: \"number\", default: 1, label: \"Разовый множитель\" } },\n      },\n      result: { type: \"number\" },\n      async run({ args, params, refs, state, engine }) {\n        const amount = params.base * params.multiplier * args.factor;\n        const value = await engine.invoke(refs.counter, \"add\", { amount });\n        state.awards += 1;\n        await engine.emit(\"awarded\", { amount, value });\n        return value;\n      },\n    },\n  },\n};\n",
        "fingerprint": "1563:65abf1e6",
        "dependencies": {
          "functions": {},
          "events": {},
          "references": {},
          "globals": {},
          "signals": {},
          "operations": {}
        },
        "signalBindings": {
          "awarded": {
            "signalId": "user.component-signal.sample-source--eward.awarded"
          }
        },
        "lesson": "Что открыть → Reward.award. Что изменить → формулу amount; добавьте bonus. Результат → кнопка/история/награда используют изменённый метод.",
        "locations": {
          "award": {
            "line": 40,
            "column": 7
          }
        }
      },
      {
        "id": "sample-source-Counter",
        "version": 1,
        "kind": "component.code",
        "name": "Counter",
        "path": "Компоненты/Counter.js",
        "definitionId": "sample.component.counter",
        "status": "ready",
        "approved": true,
        "source": "// Откройте Add: измените умножение на params.step — результат изменится во всех вызовах.\n// Один исходник, независимое value у каждого подключения.\nconst component = {\n  name: \"Counter\",\n  parameters: {\n    type: \"object\",\n    properties: {\n      initial: { type: \"number\", default: 0, label: \"Начальное значение\" },\n      storySource: {\n        type: \"boolean\",\n        default: false,\n        label: \"Менять источник постоянной привязки явно\",\n      },\n      step: { type: \"number\", default: 1, label: \"Множитель изменения\" },\n    },\n  },\n  state: {\n    type: \"object\",\n    properties: { value: { type: \"number\", default: 0, label: \"Текущее значение\" } },\n  },\n  stateFromParameters: { value: \"initial\" },\n  signals: {\n    changed: {\n      name: \"Значение изменилось\",\n      payloadSchema: { type: \"object\", properties: { value: { type: \"number\" } } },\n    },\n  },\n  methods: {\n    add: {\n      name: \"Добавить\",\n      parameters: {\n        type: \"object\",\n        properties: { amount: { type: \"number\", default: 1, label: \"Количество\" } },\n      },\n      result: { type: \"number\" },\n      async run({ args, params, state, engine }) {\n        const next = state.value + args.amount * params.step;\n        if (params.storySource) await engine.writeBinding(\"value\", next);\n        else state.value = next;\n        await engine.emit(\"changed\", { value: state.value });\n        return state.value;\n      },\n    },\n    read: {\n      name: \"Прочитать\",\n      result: { type: \"number\" },\n      run({ state }) {\n        return state.value;\n      },\n    },\n    multiply: {\n      name: \"Умножить\",\n      parameters: {\n        type: \"object\",\n        properties: { factor: { type: \"number\", default: 2, label: \"Множитель\" } },\n      },\n      result: { type: \"number\" },\n      async run({ args, params, state, engine }) {\n        const next = state.value * args.factor;\n        if (params.storySource) await engine.writeBinding(\"value\", next);\n        else state.value = next;\n        await engine.emit(\"changed\", { value: state.value });\n        return state.value;\n      },\n    },\n  },\n};\n",
        "fingerprint": "2083:e0bc205",
