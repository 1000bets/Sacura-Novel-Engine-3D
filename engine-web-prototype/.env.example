# Create the first account on a fresh install, or migrate legacy projects to it.
APP_USER=
APP_PASSWORD=
# Generate an S3 secret: openssl rand -hex 32
S3_ACCESS_KEY=sacura-owner
S3_SECRET_KEY=
S3_BUCKET=sacura-meshes
S3_REGION=us-east-1
# Local S3-compatible storage. For AWS/provider set its HTTPS endpoint.
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# For an existing bucket on a cloud provider set false.
S3_CREATE_BUCKET=true
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Production HTTPS override:
DOMAIN=
ACME_EMAIL=

# Optional canonical frontend origin (https://editor.example.com); defaults to request Host.
FRONTEND_BASE_URL=
# Direct Node development ignores forwarded IPs by default. Compose sets TRUST_PROXY=1
# because API is private and only Nginx forwards requests with a sanitized IP.
