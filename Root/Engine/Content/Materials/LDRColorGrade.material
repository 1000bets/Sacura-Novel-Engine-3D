{
  "schemaVersion": 2,
  "domain": "PostProcess",
  "parameters": [
    {
      "id": "Tint",
      "type": "Color",
      "default": [
        1,
        0.95,
        0.95,
        1
      ],
      "displayName": "Tint",
      "group": "Surface"
    }
  ],
  "postProcessStage": "AfterToneMapping",
  "shader": "float4 EvaluatePostProcess(SakuraPostProcessInput Input)\n{\n    MaterialParameters Parameters = GetMaterialParameters();\n    return float4(saturate(Input.SceneColor.rgb * Parameters.Tint.rgb), Input.SceneColor.a);\n}\n"
}
