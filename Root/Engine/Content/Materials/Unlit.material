{
  "schemaVersion": 2,
  "domain": "Surface",
  "parameters": [
    {
      "id": "BaseColor",
      "type": "Color",
      "default": [
        1,
        1,
        1,
        1
      ],
      "displayName": "BaseColor",
      "group": "Surface"
    },
    {
      "id": "Emissive",
      "type": "Color",
      "default": [
        0,
        0,
        0,
        1
      ],
      "displayName": "Emissive",
      "group": "Surface"
    },
    {
      "id": "BaseColorTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "BaseColorTexture",
      "group": "Surface",
      "srgb": true
    }
  ],
  "shadingModel": "Unlit",
  "blendMode": "Opaque",
  "shader": "SakuraSurface EvaluateSurface(SakuraSurfaceInput Input)\n{\n    MaterialParameters Parameters = GetMaterialParameters();\n    SakuraSurface Surface = MakeDefaultSurface(Input);\n    float4 Color = Parameters.BaseColor * Input.VertexColor * SampleBaseColorTexture(Input.TextureCoordinates);\n    Surface.Albedo = Color.rgb;\n    Surface.Opacity = Color.a;\n    Surface.Emission = Parameters.Emissive.rgb;\n    return Surface;\n}\n"
}
