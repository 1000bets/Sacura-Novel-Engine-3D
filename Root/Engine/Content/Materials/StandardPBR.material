{
  "schemaVersion": 2,
  "domain": "Surface",
  "parameters": [
    {
      "id": "BaseColor",
      "type": "Color",
      "default": [
        1,
        1,
        1,
        1
      ],
      "displayName": "BaseColor",
      "group": "Surface"
    },
    {
      "id": "Metallic",
      "type": "Float",
      "default": 0,
      "displayName": "Metallic",
      "group": "Surface",
      "range": [
        0,
        1
      ]
    },
    {
      "id": "Roughness",
      "type": "Float",
      "default": 0.5,
      "displayName": "Roughness",
      "group": "Surface",
      "range": [
        0,
        1
      ]
    },
    {
      "id": "Emissive",
      "type": "Color",
      "default": [
        0,
        0,
        0,
        1
      ],
      "displayName": "Emissive",
      "group": "Surface"
    },
    {
      "id": "NormalStrength",
      "type": "Float",
      "default": 1,
      "displayName": "NormalStrength",
      "group": "Surface",
      "range": [
        0,
        4
      ]
    },
    {
      "id": "OcclusionStrength",
      "type": "Float",
      "default": 1,
      "displayName": "OcclusionStrength",
      "group": "Surface",
      "range": [
        0,
        1
      ]
    },
    {
      "id": "BaseColorTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "BaseColorTexture",
      "group": "Surface",
      "srgb": true
    },
    {
      "id": "NormalTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "NormalTexture",
      "group": "Surface",
      "srgb": false
    },
    {
      "id": "MetallicRoughnessTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "MetallicRoughnessTexture",
      "group": "Surface",
      "srgb": false
    },
    {
      "id": "OcclusionTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "OcclusionTexture",
      "group": "Surface",
      "srgb": false
    },
    {
      "id": "EmissiveTexture",
      "type": "Texture2D",
      "default": null,
      "displayName": "EmissiveTexture",
      "group": "Surface",
      "srgb": true
    }
  ],
  "shadingModel": "Lit",
  "blendMode": "Opaque",
  "shader": "SakuraSurface EvaluateSurface(SakuraSurfaceInput Input)\n{\n    MaterialParameters Parameters = GetMaterialParameters();\n    SakuraSurface Surface = MakeDefaultSurface(Input);\n    float4 Base = Parameters.BaseColor * Input.VertexColor;\n    if (HasBaseColorTexture())\n    {\n        Base *= SampleBaseColorTexture(Input.TextureCoordinates);\n    }\n    Surface.Albedo = Base.rgb;\n    Surface.Opacity = Base.a;\n    Surface.Metalness = Parameters.Metallic;\n    Surface.RoughnessValue = Parameters.Roughness;\n    if (HasMetallicRoughnessTexture())\n    {\n        float4 Packed = SampleMetallicRoughnessTexture(Input.TextureCoordinates);\n        Surface.Metalness *= Packed.b;\n        Surface.RoughnessValue *= Packed.g;\n    }\n    if (HasNormalTexture())\n    {\n        float3 TangentNormal = SampleNormalTexture(Input.TextureCoordinates).rgb * 2.0 - 1.0;\n        TangentNormal.xy *= Parameters.NormalStrength;\n        Surface.Normal = TangentNormalToWorld(Input, normalize(TangentNormal));\n    }\n    if (HasOcclusionTexture())\n    {\n        Surface.Occlusion = lerp(1.0, SampleOcclusionTexture(Input.TextureCoordinates).r, Parameters.OcclusionStrength);\n    }\n    Surface.Emission = Parameters.Emissive.rgb;\n    if (HasEmissiveTexture())\n    {\n        Surface.Emission *= SampleEmissiveTexture(Input.TextureCoordinates).rgb;\n    }\n    return Surface;\n}\n"
}
