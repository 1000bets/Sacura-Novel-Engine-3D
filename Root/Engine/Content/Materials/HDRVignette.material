{
  "schemaVersion": 2,
  "domain": "PostProcess",
  "parameters": [
    {
      "id": "Strength",
      "type": "Float",
      "default": 0.5,
      "displayName": "Strength",
      "group": "Surface",
      "range": [
        0,
        1
      ]
    }
  ],
  "postProcessStage": "BeforeToneMapping",
  "shader": "float4 EvaluatePostProcess(SakuraPostProcessInput Input)\n{\n    float Radius = length(Input.TextureCoordinates - 0.5);\n    float Factor = 1.0 - smoothstep(0.2, 0.71, Radius) * GetMaterialParameters().Strength;\n    return float4(Input.SceneColor.rgb * Factor, Input.SceneColor.a);\n}\n"
}
