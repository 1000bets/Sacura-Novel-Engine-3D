{
  "schemaVersion": 2,
  "domain": "UserInterface",
  "parameters": [
    {
      "id": "Tint",
      "type": "Color",
      "default": [
        0.08,
        0.07,
        0.09,
        0.9
      ],
      "displayName": "Tint",
      "group": "Surface"
    },
    {
      "id": "Radius",
      "type": "Float",
      "default": 12,
      "displayName": "Radius",
      "group": "Surface",
      "range": [
        0,
        1000
      ]
    }
  ],
  "blendMode": "Translucent",
  "shader": "float4 EvaluateUserInterface(SakuraUserInterfaceInput Input)\n{\n    MaterialParameters Parameters = GetMaterialParameters();\n    float2 HalfSize = Input.Resolution * 0.5;\n    float2 Position = abs((Input.TextureCoordinates - 0.5) * Input.Resolution) - HalfSize + Parameters.Radius;\n    float Distance = length(max(Position, 0.0)) + min(max(Position.x, Position.y), 0.0) - Parameters.Radius;\n    float Alpha = saturate(0.5 - Distance);\n    return float4(Parameters.Tint.rgb * Input.Color.rgb, Alpha * Parameters.Tint.a * Input.Color.a);\n}\n"
}
