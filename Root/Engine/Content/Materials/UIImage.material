{
  "schemaVersion": 2,
  "domain": "UserInterface",
  "parameters": [
    {
      "id": "Tint",
      "type": "Color",
      "default": [
        1,
        1,
        1,
        1
      ],
      "displayName": "Tint",
      "group": "Surface"
    },
    {
      "id": "Image",
      "type": "Texture2D",
      "default": null,
      "displayName": "Image",
      "group": "Surface",
      "srgb": true,
      "address": "Clamp"
    }
  ],
  "blendMode": "Translucent",
  "shader": "float4 EvaluateUserInterface(SakuraUserInterfaceInput Input)\n{\n    return SampleImage(Input.TextureCoordinates) * GetMaterialParameters().Tint * Input.Color;\n}\n"
}
