{
  "format": "sakura.widget",
  "version": 1,
  "controller": "engine.ui.Dialogue",
  "widget": {
    "id": "widget-default-dialogue",
    "name": "Диалог",
    "kind": "dialogue",
    "referenceSize": [
      1280,
      720
    ],
    "elements": [
      {
        "id": "widget-default-dialogue-panel",
        "name": "Диалоговое окно",
        "type": "panel",
        "parentId": null,
        "role": "none",
        "text": "",
        "action": "none",
        "visible": true,
        "layout": {
          "anchorMin": [
            0,
            1
          ],
          "anchorMax": [
            1,
            1
          ],
          "pivot": [
            0.5,
            1
          ],
          "x": 0,
          "y": -34,
          "width": -100,
          "height": 205
        },
        "style": {
          "background": "#211c29",
          "color": "#fff4f8",
          "opacity": 0.96,
          "borderRadius": 16,
          "borderWidth": 1,
          "borderColor": "#ad849d",
          "padding": 0
        }
      },
      {
        "id": "widget-default-dialogue-speaker",
        "name": "Имя персонажа",
        "type": "text",
        "parentId": "widget-default-dialogue-panel",
        "role": "none",
        "text": "Новый текст",
        "action": "none",
        "visible": true,
        "layout": {
          "anchorMin": [
            0,
            0
          ],
          "anchorMax": [
            1,
            0
          ],
          "pivot": [
            0,
            0
          ],
          "x": 28,
          "y": 18,
          "width": -56,
          "height": 32
        },
        "style": {
          "background": "transparent",
          "color": "#e2b8d1",
          "fontSize": 23,
          "fontWeight": 600,
          "padding": 0
        },
        "binding": {
          "source": "variable",
          "path": "Speaker",
          "format": ""
        }
      },
      {
        "id": "widget-default-dialogue-text",
        "name": "Текст реплики",
        "type": "text",
        "parentId": "widget-default-dialogue-panel",
        "role": "none",
        "text": "Новый текст",
        "action": "none",
        "visible": true,
        "layout": {
          "anchorMin": [
            0,
            0
          ],
          "anchorMax": [
            1,
            1
          ],
          "pivot": [
            0,
            0
          ],
          "x": 28,
          "y": 60,
          "width": -88,
          "height": -105
        },
        "style": {
          "background": "transparent",
          "color": "#fff4f8",
          "fontSize": 24,
          "padding": 0
        },
        "binding": {
          "source": "variable",
          "path": "Text",
          "format": ""
        }
      },
      {
        "id": "widget-default-dialogue-status",
        "name": "Подсказка",
        "type": "text",
        "parentId": "widget-default-dialogue-panel",
        "role": "none",
        "text": "Новый текст",
        "action": "none",
        "visible": true,
        "layout": {
          "anchorMin": [
            0,
            1
          ],
          "anchorMax": [
            1,
            1
          ],
          "pivot": [
            0,
            1
          ],
          "x": 28,
          "y": -16,
          "width": -90,
          "height": 25
        },
        "style": {
          "background": "transparent",
          "color": "#d1bfd0",
          "fontSize": 15,
          "padding": 0
        }
      },
      {
        "id": "widget-default-dialogue-next",
        "name": "Продолжить",
        "type": "button",
        "parentId": "widget-default-dialogue-panel",
        "role": "none",
        "text": "›",
        "action": "advance",
        "visible": true,
        "layout": {
          "anchorMin": [
            1,
            1
          ],
          "anchorMax": [
            1,
            1
          ],
          "pivot": [
            1,
            1
          ],
          "x": -20,
          "y": -14,
          "width": 44,
          "height": 44
        },
        "style": {
          "background": "#704e7c",
          "color": "#fff4f8",
          "fontSize": 28,
          "borderRadius": 10,
          "textAlign": "center",
          "padding": 0
        },
        "event": "Advance",
        "enabledField": "CanAdvance"
      },
      {
        "id": "widget-default-dialogue-choices",
        "name": "Ответы игрока",
        "type": "choices",
        "parentId": null,
        "role": "none",
        "text": "",
        "action": "none",
        "visible": true,
        "layout": {
          "anchorMin": [
            0.5,
            1
          ],
          "anchorMax": [
            0.5,
            1
          ],
          "pivot": [
            0.5,
            1
          ],
          "x": 0,
          "y": -255,
          "width": 620,
          "height": 190
        },
        "style": {
          "background": "transparent",
          "color": "#fff4f8",
          "fontSize": 22,
          "borderRadius": 10,
          "padding": 4,
          "gap": 8
        },
        "binding": {
          "source": "variable",
          "path": "Choices"
        },
        "event": "Choose",
        "enabledField": "CanChoose",
        "selectedField": "SelectedChoiceId"
      }
    ],
    "css": ""
  }
}
