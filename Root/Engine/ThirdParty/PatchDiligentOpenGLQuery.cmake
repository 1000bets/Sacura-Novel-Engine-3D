set(QuerySource "${DILIGENT_SOURCE_DIRECTORY}/Graphics/GraphicsEngineOpenGL/src/QueryGLImpl.cpp")
file(READ "${QuerySource}" QueryContents)
set(Original "    m_GlQuery.SetName(m_Desc.Name);")
set(Replacement "    if (glIsQuery(m_GlQuery))\n    {\n        m_GlQuery.SetName(m_Desc.Name);\n    }")
string(FIND "${QueryContents}" "${Replacement}" PatchedPosition)
if(PatchedPosition EQUAL -1)
    string(FIND "${QueryContents}" "${Original}" OriginalPosition)
    if(OriginalPosition EQUAL -1)
        message(FATAL_ERROR "Diligent OpenGL query label patch does not match the pinned source")
    endif()
    string(REPLACE "${Original}" "${Replacement}" QueryContents "${QueryContents}")
    file(WRITE "${QuerySource}" "${QueryContents}")
endif()
