if(EXISTS "${DEST_DIR}")
    message(FATAL_ERROR "Distribution output already exists; select a new SAKURA_DISTRIBUTION_DIRECTORY: ${DEST_DIR}")
endif()
foreach(Executable SakuraEditor SakuraPlayer SakuraMcpBridge)
    if(NOT EXISTS "${SOURCE_DIR}/${Executable}.exe")
        message(FATAL_ERROR "Missing distribution executable: ${Executable}")
    endif()
endforeach()
get_filename_component(DestinationParent "${DEST_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${DestinationParent}")
string(RANDOM LENGTH 12 DistributionIdentity)
set(StagingDirectory "${DestinationParent}/.sakura-distribution-${DistributionIdentity}")
file(MAKE_DIRECTORY "${StagingDirectory}/Bin")
foreach(Executable SakuraEditor SakuraPlayer SakuraMcpBridge)
    file(COPY "${SOURCE_DIR}/${Executable}.exe" DESTINATION "${StagingDirectory}/Bin")
endforeach()
set(DistributionDestination "${DEST_DIR}")
set(DEST_DIR "${StagingDirectory}/Bin")
include("${CMAKE_CURRENT_LIST_DIR}/CopyStageRuntime.cmake")
foreach(Folder studio)
    if(IS_DIRECTORY "${SOURCE_DIR}/${Folder}")
        file(COPY "${SOURCE_DIR}/${Folder}" DESTINATION "${StagingDirectory}/Bin")
    endif()
endforeach()
file(COPY "${SOURCE_DIR}/Engine" DESTINATION "${StagingDirectory}")
file(COPY "${SOURCE_ROOT}/Samples/SampleProject" DESTINATION "${StagingDirectory}/Samples"
    PATTERN "__pycache__" EXCLUDE PATTERN "Saved" EXCLUDE)
file(COPY "${SOURCE_ROOT}/docs/DISTRIBUTION.md" DESTINATION "${StagingDirectory}")
file(WRITE "${StagingDirectory}/README.txt" "Run Bin/SakuraEditor.exe. Export games with File > Export game. Distribute the entire exported folder. See DISTRIBUTION.md.\n")
file(RENAME "${StagingDirectory}" "${DistributionDestination}")
message(STATUS "Editor distribution: ${DistributionDestination}")
