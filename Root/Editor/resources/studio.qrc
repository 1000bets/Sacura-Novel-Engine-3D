<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/ui/icons">
        <file alias="LUCIDE-LICENSE">ui/icons/LUCIDE-LICENSE</file>
    </qresource>
    <qresource prefix="/ui/styles">
        <file alias="chevron-down.png">ui/styles/chevron-down.png</file>
        <file alias="close.png">ui/styles/close.png</file>
        <file alias="editor.qss">ui/styles/editor.qss</file>
        <file alias="controls.qss">ui/styles/controls.qss</file>
        <file alias="story.qss">ui/styles/story.qss</file>
        <file alias="classic.json">ui/styles/classic.json</file>
        <file alias="sakura.json">ui/styles/sakura.json</file>
    </qresource>
    <qresource prefix="/studio">
        <file alias="template_visual_novel.png">studio/template_visual_novel.png</file>
        <file alias="template_kinetic_novel.png">studio/template_kinetic_novel.png</file>
        <file alias="studio_sakura_overlay.png">studio/studio_sakura_overlay.png</file>
        <file alias="checkbox_check.png">studio/checkbox_check.png</file>
    </qresource>
    <qresource prefix="/component-icons">
        <file alias="sun.png">component-icons/sun.png</file>
        <file alias="lightbulb.png">component-icons/lightbulb.png</file>
        <file alias="flashlight.png">component-icons/flashlight.png</file>
        <file alias="LICENSE">component-icons/LICENSE</file>
    </qresource>
</RCC>
