/* EditorSelect.jsx, objectInspector.css, editorTheme.css. Logical CSS pixels. */
/* Editor.jsx renderActive / editor.css active-table / editorHelp.css workspace-guide. */
QWidget#AudioEnvironment, QWidget#AudioEnvironmentBody { background: @--bg-panel@; }
QWidget#AudioEnvironmentGuide, QWidget[uiRole="audioTableHeader"], QWidget[uiRole="audioEventRow"] {
    border-bottom: 1px solid @--border-subtle@;
}
QLabel[uiRole="audioTitle"] { font-size: 17px; font-weight: 600; color: @--text-primary@; }
QLabel[uiRole="audioDescription"], QLabel[uiRole="audioFooter"] { font-size: 12px; color: @--text-muted@; }
QLabel[uiRole="audioFooter"] { padding: 15px 0; }
QLabel[uiRole="audioHeader"], QLabel[uiRole="audioOrigin"] { font-size: 11px; color: @--text-muted@; }
QLabel[uiRole="audioEventName"] { font-size: 13px; font-weight: 500; color: @--accent@; }
QLabel[uiRole="audioScope"] { font-size: 12px; color: @--accent@; }
QLabel[uiRole="audioStatus"] { font-size: 12px; color: @--text-secondary@; }
QPushButton[uiRole="audioShortcut"] {
    padding: 8px 12px; min-height: 18px; font-size: 12px;
    background: @--border-subtle@; border: 1px solid transparent; border-radius: 4px;
}
QPushButton[uiRole="audioShortcut"]:hover { background: @--bg-hover@; }
QPushButton[uiRole="audioShortcut"]:disabled { color: @--text-disabled@; }
QPushButton[uiRole="audioControl"] {
    padding: 5px; min-width: 16px; max-width: 16px; min-height: 16px; max-height: 16px;
    border: 1px solid @--border-subtle@; border-radius: 4px; background: transparent;
}
QPushButton[uiRole="audioControl"]:hover { background: @--bg-hover@; }
QPushButton[uiRole="audioControl"]:focus { border-color: @--accent@; }
QWidget#HierarchyPanelContent { background: @--bg-panel@; }
QComboBox[uiRole="studioSelect"] { padding-right: 24px; }
QComboBox[uiRole="studioSelect"]:focus, QComboBox[uiRole="studioSelect"][popupOpen="true"],
QWidget#StoryInspector QComboBox[uiRole="studioSelect"]:focus,
QWidget#StoryInspector QComboBox[uiRole="studioSelect"][popupOpen="true"] { border: 1px solid @--accent@; }
QWidget#StudioSelectPopup {
    background: @--bg-panel-elevated@; border: 1px solid @--border-subtle@;
    border-radius: 6px;
}
QListWidget#StudioSelectOptions {
    background: transparent; border: none; padding: 0; outline: none; font-size: 13px;
}
QListWidget#StudioSelectOptions::item { padding: 0; border: none; background: transparent; }
QWidget#StudioSelectPopup QLineEdit#StudioSelectSearch {
    background: @--bg-input@; border: 1px solid transparent; border-radius: 4px;
    min-height: 18px; max-height: 16777215px; padding: 5px 8px; font-size: 12px;
}
QWidget#StudioSelectPopup QLineEdit#StudioSelectSearch:focus { border-color: @--border-strong@; }
QWidget#HierarchySearchBox {
    min-height: 30px; max-height: 30px; border: 1px solid transparent;
    border-radius: 4px; background: @--bg-input@;
}
QLineEdit#HierarchySearch {
    min-height: 28px; max-height: 28px; padding: 0; border: none;
    background: transparent; font-size: 12px;
}
QLineEdit#HierarchySearch:focus { border: none; }
QWidget#HierarchySearchBox[searchFocused="true"] { border-color: @--accent@; }
QWidget#SceneObjectsHeading { margin: 0; min-height: 38px; max-height: 38px; }
QLabel#SceneObjectCount { min-height: 20px; max-height: 20px; padding: 0 4px; }
QWidget#ObjectInspectorBody { background: @--bg-panel@; }
QWidget#ObjectIdentity { min-height: 64px; border-bottom: 1px solid @--border-subtle@; }
QLineEdit#ObjectName { background: transparent; font-size: 14px; font-weight: 600; padding: 3px 0; }
QLabel#ObjectKind, QLabel#ObjectComponentCount, QLabel#ObjectComponentEmpty { font-size: 11px; color: @--text-muted@; }
QWidget#ObjectComponents { border-bottom: 1px solid @--border-subtle@; }
QWidget#ObjectComponents QToolButton { min-width: 26px; min-height: 26px; padding: 0; background: transparent; border: 0; }
QWidget#ObjectComponents QPushButton[uiRole="componentInstance"] {
    min-height: 40px; padding: 0 8px; text-align: left; border: 0;
    background: transparent; font-size: 12px; font-weight: 500;
}
QWidget#ObjectComponents QPushButton[uiRole="componentInstance"]:hover { background: @--bg-hover@; }
QPushButton#ObjectAddComponent { min-height: 32px; padding: 0 8px; border: 1px solid @--border-strong@;
    background: @--accent-muted@; font-size: 12px; font-weight: 600; color: @--text-primary@; }
QPushButton#ObjectAddComponent:hover { border-color: @--accent@; background: @--bg-hover@; }
QLabel#ObjectSelectionFooter { min-height: 24px; max-height: 24px; padding: 0 8px;
    font-size: 11px; color: @--text-muted@; background: @--bg-panel@; border-top: 1px solid @--border-subtle@; }
QGroupBox#MeshInspectorCard { margin-top: 16px; margin-bottom: 12px; padding: 0;
    border: 1px solid @--border-subtle@; border-radius: 8px; font-size: 12px; font-weight: 600;
    color: @--text-primary@; background: transparent; }
QGroupBox#MeshInspectorCard::title { subcontrol-origin: margin; subcontrol-position: top left; left: 12px; top: 8px; padding: 0 5px; }
QGroupBox#MeshInspectorCard QWidget#ReflectionInspector { background: transparent; }
QLabel#MeshInspectorNote { font-size: 11px; color: @--text-muted@; }
QPushButton#MeshUpload { background: transparent; min-height: 30px; font-size: 12px; }
QToolButton#MeshDetails { background: transparent; min-height: 30px; text-align: left; padding: 0; }
QWidget#ObjectTransform { border-bottom: 1px solid @--border-subtle@; }
QLabel[uiRole="objectSectionTitle"] { font-size: 12px; font-weight: 600; color: @--text-primary@; }
QLabel[uiRole="transformCaption"], QLabel#TransformUnit { font-size: 11px; }
QLabel#TransformAxisX, QLabel#TransformAxisY, QLabel#TransformAxisZ { font-size: 10px; font-weight: 500; }
QLabel#TransformAxisX { color: #e99a9e; }
QLabel#TransformAxisY { color: #8cbfad; }
QLabel#TransformAxisZ { color: #9bb8d4; }
QWidget#TransformVector QDoubleSpinBox {
    font-size: 11px; min-height: 26px; padding: 0 4px; border-radius: 4px;
}
QWidget#ObjectTransform QPushButton { min-height: 26px; padding: 0 5px; font-size: 11px; }
QToolButton[uiRole="objectSection"] {
    min-height: 36px; max-height: 36px; padding: 0 16px; border: none;
    border-radius: 0; background: transparent; text-align: left; font-size: 12px;
    font-weight: 500; color: @--text-primary@;
}
QToolButton[uiRole="objectSection"]:hover { background: @--bg-hover@; }
QWidget#ComponentInspectorCard { border-bottom: 1px solid @--border-subtle@; }
QPushButton[uiRole="propertyReset"] { min-height: 26px; padding: 0; max-width: 24px; }
QWidget#ReflectionInspector QPushButton { min-height: 24px; }
QCheckBox { spacing: 8px; min-height: 24px; }

/* EditorContextMenu: shared by story creation, card actions and event pickers. */
QMenu#StudioActionMenu {
    background: @--bg-panel@; color: @--text-primary@;
    border: 1px solid @--border-subtle@; border-radius: 6px;
    padding: 8px; font-size: 12px; menu-scrollable: 1;
}
QMenu#StudioActionMenu::item {
    padding: 7px 7px; min-height: 18px; border-radius: 3px;
    background: transparent;
}
QMenu#StudioActionMenu::item:selected { background: @--bg-hover@; }
QMenu#StudioActionMenu::item:disabled { color: @--text-disabled@; }
QMenu#StudioActionMenu::icon { padding-left: 7px; }
QLabel#StudioMenuTitle { padding: 5px 7px 10px; font-size: 12px; font-weight: 600; color: @--text-primary@; }
QWidget#StudioMenuSearchBox {
    border: 1px solid @--border-subtle@; border-radius: 3px; background: transparent;
}
QLineEdit#StudioMenuSearch {
    background: transparent; color: @--text-primary@; font-size: 12px;
    padding: 3px; min-height: 18px; max-height: 16777215px; border: 1px solid transparent;
}
QLineEdit#StudioMenuSearch:focus { border-color: @--accent@; }
QLabel#StudioMenuGroup {
    margin-top: 6px; margin-bottom: 3px; padding: 6px 7px 3px;
    border-top: 1px solid @--border-subtle@; color: @--text-muted@; font-size: 10px;
}
QLabel#StudioMenuEmpty { padding: 10px 7px; color: @--text-muted@; font-size: 11px; }
