QWidget#WidgetWorkspace, QWidget#WidgetLibrary, QWidget#WidgetInspectorForm {
    background: @--bg-panel@; color: @--text-primary@;
}
QWidget#WidgetHeader { background: @--bg-panel@; border-bottom: 1px solid @--border-subtle@; }
QWidget#WidgetCanvasArea { background: @--bg-app@; }
QWidget#WidgetWorkspace QScrollArea { border: none; background: @--bg-panel@; }
QWidget#WidgetWorkspace QLabel { background: transparent; font-size: 12px; }
QWidget#WidgetWorkspace QLabel[uiRole="widgetHeading"] { font-size: 13px; font-weight: 600; padding: 6px 0; }
QWidget#WidgetWorkspace QLabel[uiRole="widgetHint"] { color: @--text-secondary@; font-size: 11px; }
QWidget#WidgetWorkspace QLineEdit, QWidget#WidgetWorkspace QDoubleSpinBox,
QWidget#WidgetWorkspace QComboBox { min-height: 28px; background: @--bg-input@; border: 1px solid transparent; border-radius: 4px; padding: 2px 6px; }
QWidget#WidgetWorkspace QLineEdit:focus, QWidget#WidgetWorkspace QDoubleSpinBox:focus { border-color: @--accent@; }
QWidget#WidgetWorkspace QPushButton { min-height: 27px; border: 1px solid transparent; border-radius: 4px; padding: 3px 6px; }
QWidget#WidgetWorkspace QPushButton:hover { background: @--bg-hover@; }
QWidget#WidgetWorkspace QPushButton:disabled { color: @--text-disabled@; }
QWidget#WidgetWorkspace QPushButton[uiRole="widgetDisclosure"] { text-align: left; font-weight: 600; }
QListWidget#WidgetElements { border: 0; background: transparent; outline: 0; }
QListWidget#WidgetElements::item { min-height: 34px; border: 1px solid transparent; border-radius: 4px; padding: 2px 4px; }
QListWidget#WidgetElements::item:selected { background: @--accent-muted@; border-color: @--accent@; }
QLabel#WidgetEmptySelection { padding: 32px 16px; }
QLabel#WidgetSaveNote { background: @--bg-panel@; color: @--text-secondary@; border-top: 1px solid @--border-subtle@; padding: 6px 12px; font-size: 11px; }
QLabel#WidgetSaveNote[error="true"] { color: @--error@; }
QWidget#WidgetWorkspace QGroupBox { border: 0; border-top: 1px solid @--border-subtle@; margin-top: 10px; padding-top: 20px; }
