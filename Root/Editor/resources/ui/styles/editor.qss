/* Native mapping of editorTheme.css: continuous rails, one command bar, quiet controls. */
QMainWindow#EditorMainWindow, QWidget#EditorRoot {
    background: @--bg-app@; color: @--text-primary@;
    font-family: "Inter", "Segoe UI"; font-size: 13px;
}
QWidget { color: @--text-secondary@; font-family: "Inter", "Segoe UI"; font-size: 12px; }
QWidget#StudioHeader, QWidget#HierarchyPanel, QWidget#InspectorPanel,
QWidget#ViewportTabs, QFrame#ViewportHeader, QWidget#BlueprintSidebar {
    background: @--bg-panel@;
}
QWidget#StudioHeader { border-bottom: 6px solid @--bg-app@; }
QLabel { background: transparent; border: none; }
QLabel#EditorBrand { font-size: 14px; font-weight: 500; color: @--text-primary@; }
QLabel#ProjectTitle, QLabel#MutedLabel, QLabel#HierarchyFooter, QLabel#EditorMode {
    color: @--text-muted@; font-size: 11px;
}
QLabel#EditorMode { color: @--success@; }
QMenuBar { background: transparent; border: none; spacing: 4px; }
QMenuBar::item { padding: 7px 10px; background: transparent; color: @--text-secondary@; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: @--bg-hover@; border-radius: 4px; }
QMenu { background: @--bg-panel-elevated@; color: @--text-primary@; border: 1px solid @--border-subtle@; padding: 5px; }
QMenu::item { padding: 7px 20px; border-radius: 3px; }
QMenu::item:selected { background: @--bg-hover@; }
QMenu::item:disabled { color: @--text-disabled@; }
QMenu::separator { height: 1px; background: @--border-subtle@; margin: 4px 6px; }
QSplitter { background: @--bg-app@; }
QSplitter::handle { background: @--bg-app@; }
QSplitter::handle:hover { background: @--border-subtle@; }
QTabWidget::pane { border: none; background: @--bg-panel@; top: 0; }
QTabWidget { background: @--bg-panel@; border: none; }
QTabBar { background: @--bg-panel@; qproperty-drawBase: 0; }
QTabBar::tab { height: 34px; padding: 0 10px; margin: 0; background: transparent; border: none; border-bottom: 1px solid transparent; color: @--text-muted@; font-size: 12px; }
QTabBar::tab:selected { color: @--text-primary@; font-weight: 500; border-bottom: 1px solid @--tab-indicator@; }
QTabBar::tab:hover { background: @--bg-hover@; }
QTabBar::close-button { image: url(:/ui/styles/close.png); width: 10px; height: 10px; padding: 3px; }
QTabBar::close-button:hover { background: @--bg-hover@; }
/* EditorWorkspace.jsx: compact, accented document tabs in the workspace. */
QTabBar[workspaceArea="workspace"]::tab { height: 28px; padding: 0 6px 0 10px; font-size: 10px; }
QTabBar[workspaceArea="workspace"]::tab:selected {
    color: @--accent@; font-weight: normal; border-bottom: 1px solid @--tab-indicator@;
}
QWidget#ViewportTabs { min-height: 36px; max-height: 36px; }
QFrame#ViewportHeader { min-height: 32px; max-height: 32px; border: none; }
QPushButton, QToolButton { background: @--bg-panel-elevated@; color: @--text-secondary@; border: 1px solid transparent; border-radius: 4px; padding: 5px 9px; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: @--bg-hover@; color: @--text-primary@; }
QPushButton:checked, QToolButton:checked { background: @--bg-active@; color: @--accent@; }
QPushButton:disabled, QToolButton:disabled { color: @--text-disabled@; }
QPushButton:focus, QToolButton:focus { border-color: @--border-strong@; }
QPushButton[uiRole="chromeButton"], QToolButton#InspectorSection {
    background: transparent; border: none; min-height: 26px; padding: 0 6px; font-size: 12px;
}
QPushButton[uiRole="chromeButton"]:hover { background: @--bg-hover@; }
QWidget#ViewportTabs QPushButton[uiRole="chromeButton"]:checked { background: transparent; color: @--text-primary@; font-weight: 500; }
QPushButton#PlayButton { background: transparent; color: @--text-secondary@; min-height: 28px; }
QPushButton#PlayButton:checked { background: @--bg-active@; }
QPushButton#ViewportGizmoButton { padding: 0; min-height: 24px; background: transparent; border: none; }
QPushButton#ViewportGizmoButton:checked { background: @--bg-active@; }
QPushButton#ViewportGizmoButton:hover { background: @--bg-hover@; }
QPushButton#HierarchyAdd { min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; padding: 0; }
QToolButton::menu-indicator { image: none; }
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background: @--bg-input@; color: @--text-primary@; border: 1px solid transparent;
    border-radius: 4px; padding: 4px 7px; selection-background-color: @--accent-muted@;
    selection-color: @--text-primary@; min-height: 18px;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: @--border-strong@; }
QLineEdit:hover, QComboBox:hover, QDoubleSpinBox:hover { background: @--bg-hover@; }
QLineEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled { color: @--text-disabled@; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: @--bg-panel-elevated@; selection-background-color: @--bg-hover@; color: @--text-primary@; }
QTreeWidget, QListWidget { background: @--bg-panel@; color: @--text-secondary@; border: none; outline: none; }
QTreeWidget { padding: 2px 8px 12px 8px; }
QTreeWidget::item { height: 28px; padding: 0 4px; border: none; border-radius: 4px; }
QTreeWidget::item:selected { background: @--bg-active@; color: @--text-primary@; }
QTreeWidget::item:hover { background: @--bg-hover@; }
/* HierarchyTree.jsx / .scene-objects-children. The delegate owns row painting. */
QTreeWidget#SceneHierarchy { padding: 2px 8px 12px 4px; }
QTreeWidget#SceneHierarchy::item,
QTreeWidget#SceneHierarchy::item:selected,
QTreeWidget#SceneHierarchy::item:hover { height: 30px; padding: 0; background: transparent; border: none; }
QTreeWidget#SceneHierarchy::branch { background: transparent; }
QWidget#SceneObjectsHeading { background: @--bg-panel-elevated@; margin: 0 8px 4px; min-height: 38px; border-radius: 4px; }
QWidget#SceneObjectsHeading QLabel { font-size: 12px; font-weight: 600; color: @--text-primary@; }
QLabel#SceneObjectCount { background: @--accent-muted@; color: @--accent@; font-size: 11px; padding: 2px 5px; border-radius: 3px; }
QLabel#HierarchyFooter { padding: 8px 12px; }
QWidget#ObjectInspectorPage, QWidget#ComponentInspectorList, QWidget#StoryInspector { background: @--bg-panel@; }
QScrollArea { background: transparent; border: none; }
QGroupBox { border: none; border-top: 1px solid @--border-subtle@; margin-top: 20px; padding-top: 8px; color: @--text-primary@; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 4px; }
QLabel#InspectorIdentity { min-height: 64px; font-size: 14px; font-weight: 500; color: @--text-primary@; }
QToolButton#InspectorSection { text-align: left; border-top: 1px solid @--border-subtle@; border-radius: 0; font-weight: 500; padding: 6px 0; }
QLabel#ContinuationField { padding: 8px; background: @--bg-input@; border-radius: 4px; color: @--text-secondary@; }
QWidget#GraphToolbar { background: @--bg-app@; min-height: 32px; max-height: 32px; }
QLabel#BlueprintHeading { min-height: 44px; color: @--text-primary@; font-size: 14px; font-weight: 600; border-bottom: 1px solid @--border-subtle@; }
QGraphicsView#StoryCanvas { background: @--bg-app@; border: none; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: @--border-strong@; border-radius: 3px; min-height: 24px; }
QScrollBar:horizontal { background: transparent; height: 7px; margin: 0; }
QScrollBar::handle:horizontal { background: @--border-strong@; border-radius: 3px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QStatusBar { background: @--bg-panel@; border: none; min-height: 23px; max-height: 23px; font-size: 11px; }
QStatusBar::item { border: none; }
QStatusBar QLabel { font-size: 11px; color: @--text-muted@; }
QToolTip { background: @--bg-panel-elevated@; color: @--text-primary@; border: 1px solid @--border-subtle@; padding: 5px; }
QLabel[uiRole="sectionTitle"] { font-size: 15px; font-weight: 500; color: @--text-primary@; }
QLabel[uiRole="description"] { font-size: 12px; }

QWidget#GraphNavigation { background: @--bg-panel@; }
QWidget#GraphNavigation QPushButton { padding: 0; border: none; border-radius: 0; background: transparent; font-size: 16px; }
QWidget#GraphNavigation QPushButton:hover { background: @--bg-hover@; }

QWidget#StoryInspectorBody { background: @--bg-panel@; }
QPushButton#StoryAddNode::menu-indicator { image: none; }

QComboBox::down-arrow { image: url(:/ui/styles/chevron-down.png); width: 10px; height: 10px; }

QWidget#StoryInspector QTextEdit { font-size: 13px; padding: 8px; }

/* React viewport tabs and commandbar: 36 + 32 logical pixels. */
QPushButton[uiRole="viewportTab"] {
    min-height: 35px; max-height: 35px; padding: 0 2px; margin: 0;
    background: transparent; border: none; border-bottom: 1px solid transparent;
    border-radius: 0; color: @--text-muted@; font-size: 12px;
}
QPushButton[uiRole="viewportTab"]:checked {
    color: @--text-primary@; font-weight: 600; border-bottom-color: @--tab-indicator@;
}
QPushButton[uiRole="viewportTab"]:hover { color: @--text-primary@; }
QPushButton[uiRole="viewportTool"], QPushButton[uiRole="viewportToggle"], QToolButton[uiRole="viewportUtility"] {
    background: transparent; border: none; padding: 0; min-height: 0; border-radius: 4px;
}
QPushButton[uiRole="viewportTool"]:hover, QPushButton[uiRole="viewportToggle"]:hover,
QToolButton[uiRole="viewportUtility"]:hover { background: @--bg-hover@; }
QPushButton[uiRole="viewportTool"]:checked { background: @--bg-active@; }
QPushButton[uiRole="viewportToggle"]:checked { background: transparent; }
QPushButton[uiRole="viewportTool"]:focus, QPushButton[uiRole="viewportToggle"]:focus,
QToolButton[uiRole="viewportUtility"]:focus { border: 1px solid @--border-strong@; }
/* Tool windows share the editor surface when detached from the main shell. */
QWidget[uiRole="workspaceFloating"] { background: @--bg-panel@; color: @--text-primary@; }
