/* AssetExplorer.jsx / assetExplorer.css: sizes are logical pixels. */
QWidget#AssetExplorer, QWidget#ExplorerBreadcrumbs, QScrollArea#ExplorerBreadcrumbScroll {
    background: @--bg-panel@;
}
QWidget#ContentBrowserToolbar { background: @--bg-panel@; border-bottom: 1px solid @--border-subtle@; }
QWidget#ContentBrowserToolbar QToolButton {
    background: transparent; color: @--text-primary@; padding: 6px; border-radius: 3px;
}
QWidget#ContentBrowserToolbar QToolButton:hover { background: @--bg-hover@; }
QWidget#ContentBrowserToolbar QToolButton:disabled { color: @--text-disabled@; }
QLineEdit#ContentBrowserSearch {
    background: @--bg-panel-elevated@; color: @--text-primary@;
    border: 1px solid transparent; border-radius: 0; padding: 7px 2px;
}
QLineEdit#ContentBrowserSearch:focus { border-color: @--accent@; }
QTreeWidget#ContentBrowserSources {
    background: @--bg-panel@; color: @--text-primary@; padding: 8px;
    border: none; border-right: 1px solid @--border-subtle@;
}
QTreeWidget#ContentBrowserSources::item { height: 30px; padding: 0 6px; border: 1px solid transparent; border-radius: 3px; }
QTreeWidget#ContentBrowserSources::item:selected { background: @--bg-active@; border-color: @--accent@; }
QTreeWidget#ContentBrowserSources::item:hover:!selected { background: @--bg-hover@; }
QTreeWidget#ContentBrowserSources::branch { background: transparent; }
QTreeWidget#ContentBrowserSources::branch:selected { background: @--bg-panel@; }
QListWidget#ContentBrowserAssets { background: @--bg-panel@; color: @--text-primary@; padding: 8px; border: none; }
QSplitter#ExplorerBody::handle { background: @--border-subtle@; }
QLabel#ExplorerDropHint, QLabel#ExplorerDetails {
    color: @--text-secondary@; background: @--bg-panel@;
    border-top: 1px solid @--border-subtle@; padding: 8px 12px; font-size: 12px;
}
QLabel#ExplorerDetails { min-height: 24px; color: @--text-primary@; }
QLabel#ExplorerEmptyState { color: @--text-secondary@; background: transparent; padding: 16px; }
