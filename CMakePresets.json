{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "SAKURA_BUILD_EDITOR": "ON",
        "SAKURA_ENABLE_PYTHON": "ON",
        "SAKURA_BUILD_DILIGENT_SAMPLES": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (Editor ON)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (Editor ON)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-debug-engine-only",
      "displayName": "Windows MSVC Debug (Editor OFF)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SAKURA_BUILD_EDITOR": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug-engine-only",
      "configurePreset": "windows-msvc-debug-engine-only",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "probe"
        }
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "probe"
        }
      }
    },
    {
      "name": "windows-msvc-debug-probe-fail",
      "displayName": "Debug probe (expects failure)",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "probe"
        }
      }
    }
  ]
}
