{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS Apple Silicon Debug (Editor + CPU PhysX)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_POLICY_DEFAULT_CMP0169": "OLD",
        "SAKURA_BUILD_EDITOR": "ON",
        "SAKURA_BUILD_QT_FROM_SOURCE": "ON",
        "SAKURA_QT_BUILD_JOBS": "8",
        "SAKURA_ENABLE_PYTHON": "ON",
        "SAKURA_BUILD_DILIGENT_SAMPLES": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "SAKURA_BUILD_EDITOR": "ON",
        "SAKURA_BUILD_QT_FROM_SOURCE": "ON",
        "SAKURA_ENABLE_PYTHON": "ON",
        "SAKURA_BUILD_DILIGENT_SAMPLES": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (Editor ON)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (Editor ON)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-debug-engine-only",
      "displayName": "Windows MSVC Debug (Editor OFF)",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SAKURA_BUILD_EDITOR": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "targets": ["SakuraEditor", "SakuraPlayer"],
      "jobs": 8
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug-engine-only",
      "configurePreset": "windows-msvc-debug-engine-only",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "probe"
        }
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "probe"
        }
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "probe"
        }
      }
    },
    {
      "name": "windows-msvc-debug-probe-fail",
      "displayName": "Debug probe (expects failure)",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "probe"
        }
      }
    }
  ]
}
