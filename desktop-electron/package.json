{
  "name": "sacura-desktop-experiment",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "native:configure": "cmake --preset windows-msvc-debug -S .. -DSAKURA_BUILD_ELECTRON_HOST=ON",
    "native:build": "cmake --build ../build/windows-msvc-debug --config Debug --target SakuraElectronHost --parallel 8",
    "native:start": "node scripts/native-start.cjs",
    "native:smoke": "node scripts/native-start.cjs --smoke",
    "native:probe": "electron scripts/probe-native-bridge.cjs",
    "desktop:dev": "node scripts/dev.cjs",
    "desktop:build": "npm run native:build && npm run build:ui && electron-builder --dir",
    "smoke:editor": "node scripts/smoke-editor.cjs",
    "smoke:hmr": "node scripts/hmr-check.cjs",
    "build:ui": "npm --prefix ../engine-web-prototype/frontend run build -- --base ./ --outDir ../../desktop-electron/dist-ui --emptyOutDir",
    "test": "node --test tests",
    "test:bridge": "node --test tests/bridge-contract.test.cjs tests/native-bridge.test.cjs ../engine-web-prototype/frontend/tests/nativeBridgeClient.test.js",
    "native:configure:release": "cmake --preset windows-msvc-release -S .. -DSAKURA_BUILD_ELECTRON_HOST=ON \"-DCMAKE_POLICY_VERSION_MINIMUM=3.5\"",
    "native:build:release": "cmake --build ../build/windows-msvc-release --config Release --target SakuraElectronHost --parallel 8",
    "desktop:production": "npm run native:build:release && npm run build:ui && electron-builder --config electron-builder.production.cjs --win zip"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.sacura.desktop.experiment",
    "productName": "Sacura Desktop Experiment",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "project-store.cjs",
      "native-viewport.cjs",
      "asset-windows.cjs",
      "bridge/**/*",
      "scripts/native-smoke-main.cjs",
      "dist-ui/**/*",
      "package.json",
      "native-project.cjs",
      "native-recents.cjs",
      "player-main.cjs",
      "game-export.cjs",
      "scripts/player-smoke.cjs"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../build/windows-msvc-debug/ElectronNative/Debug",
        "to": "native",
        "filter": [
          "**/*",
          "!**/*.pdb",
          "!**/Qt*.dll",
          "!platforms/**/*",
          "!imageformats/**/*",
          "!**/*Test.exe",
          "!**/*.lib",
          "!**/*.exp"
        ]
      }
    ]
  }
}
